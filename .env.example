
# ============================================
# Environment URLs
# ============================================
# Development API URL (default: https://dev.api.byzantine.fi)
DEV_API_URL=https://dev.api.byzantine.fi

# Production API URL (default: https://api.byzantine.fi)
PROD_API_URL=https://api.byzantine.fi

# ============================================
# Environment Selection
# ============================================
# Which environment to test against: production or development (default: development)
TEST_ENV=development

# ============================================
# Chain Selection
# ============================================
# Set `ETH` for Ethereum, `BASE` for Base (default to BASE)
CHAIN=BASE

# ============================================
# API INTEGRATOR Authentication
# ============================================
# dev
DEV_INTEGRATOR_PRIVATE_KEY=
# prod
# PROD_INTEGRATOR_PRIVATE_KEY=

# ============================================
# Feature Flags
# ============================================
ENABLE_WRITE_TESTS=true

ENABLE_PASSKEY_TESTS=true
ENABLE_PASSKEY_INIT_ACTIVATE_TESTS=
ENABLE_PASSKEY_INIT_DEPOSIT_TESTS=
ENABLE_PASSKEY_INIT_WITHDRAW_TESTS=
ENABLE_PASSKEY_ACTIVATE_TX_TESTS=
ENABLE_PASSKEY_DEPOSIT_TX_TESTS=
ENABLE_PASSKEY_WITHDRAW_TX_TESTS=

ENABLE_OTP_TESTS=false
ENABLE_OTP_INIT_DEPOSIT_TESTS=false
ENABLE_OTP_INIT_WITHDRAW_TESTS=false
ENABLE_OTP_DEPOSIT_TX_TESTS=
ENABLE_OTP_WITHDRAW_TX_TESTS=

# To run only user creation tests, use `CREATE_ENTITY=false`
CREATE_USER=
CREATE_ENTITY=

# Test minimal required fields (disabled by default)
CREATE_USER_MINIMAL=false
CREATE_ENTITY_MINIMAL=false

# User invitation tests (enabled by default)
INVITE_PAYLOAD=true
INVITE_USERS=true

# Role management tests (disabled by default, requires passkey authentication)
UPDATE_ROLE_PAYLOAD=false
UPDATE_ROLE=false

# Invitation query tests (enabled by default)
ENABLE_INVITATION_QUERIES=true

# ============================================
# CI Passkey Signing (from ci-one-time-setup.js)
# ============================================
# Pure Node.js signing — no Playwright needed in CI
# Run `npm run ci:one-time-setup` once to generate these values
CI_PASSKEY_CREDENTIAL_ID=
CI_PASSKEY_PRIVATE_KEY=
CI_PASSKEY_ACCOUNT_ID=

# ============================================
# Virtual Authenticator (Playwright + CDP) — Fallback
# ============================================
# Only needed if CI_PASSKEY secrets are not set
USE_VIRTUAL_AUTH=false
VIRTUAL_AUTH_PORT=3000
VIRTUAL_AUTH_RPID=localhost

# ============================================
# Debugging
# ============================================
DEBUG_MODE=false

# ============================================
# Test data used in production testing mode (related to Bridge)
# ============================================
TEST_VAULT_ETH=
TEST_VAULT_BASE=

TEST_USER_ID=
TEST_ACCOUNT_ID=
TEST_ENTITY_ID=
TEST_ENTITY_ACCOUNT_ID=
TEST_ENTITY_ROOT_USER_ID=
TEST_TRANSACTION_ID=

# Bank account IDs (resolved from generated data or override here)
TEST_US_BANK_ACCOUNT_ID=
TEST_EUR_BANK_ACCOUNT_ID=

# Additional user ID for role management tests
TEST_ADDITIONAL_USER_ID=
TEST_ROLE_TARGET_USER_ID=

# KYC/KYB-approved account ID for bank account tests (add-bank-account requires approved status)
TEST_BANK_ACCOUNT_TARGET_ID=
# KYC/KYB-approved account ID for passkey tests (init-passkey requires approved status)
TEST_INIT_ACTIVATE_TARGET_ACCOUNT_ID=
TEST_INIT_DEPOSIT_TARGET_ACCOUNT_ID=
TEST_INIT_WITHDRAW_TARGET_ACCOUNT_ID=

TEST_USER_EMAIL=

ENABLE_OTP_INIT_AUTH_TESTS=
ENABLE_OTP_AUTHENTICATE_TESTS=
ENABLE_OTP_CREATE_AUTHENTICATORS_TESTS=
TEST_OTP_CODE=

# ============================================
# Invitation + OTP Flow (CI automation)
# ============================================
# Enable the full invite → OTP → authenticator flow in ci-test.js
ENABLE_INVITE_OTP_FLOW=false

# Mailslurp API key for automatic OTP retrieval via disposable email inboxes
# Sign up at https://app.mailslurp.com (free tier: 100 emails/month)
# When set, ci-test.js creates a disposable inbox, uses it for the invitation,
# and automatically extracts the OTP code from the received email.
MAILSLURP_API_KEY=

# Override the invited user's email (used by Mailslurp automation or manual testing)
# When set, the first invited user gets this email instead of a generated one.
CI_INVITE_EMAIL=