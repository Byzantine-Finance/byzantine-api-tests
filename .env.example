# ============================================
# Environment URLs
# ============================================
# Development API URL
DEV_API_URL=

# Production API URL
PROD_API_URL=

# ============================================
# Environment Selection
# ============================================
# Which environment to test against: production or development (default: development)
TEST_ENV=development

# ============================================
# Chain Selection
# ============================================
# Set `ETH` for Ethereum, `BASE` for Base (default to BASE)
CHAIN=BASE

# ============================================
# API INTEGRATOR Authentication
# ============================================
# DEV
DEV_INTEGRATOR_PRIVATE_KEY=
# PROD
PROD_INTEGRATOR_PRIVATE_KEY=

# ============================================
# Feature Flags
# ============================================
# Write tests (POST/PATCH/DELETE) are ENABLED BY DEFAULT outside production.
# Set to false to run read-only.
ENABLE_WRITE_TESTS=
# Security flag to force write on production
FORCE_WRITE_TESTS=

# Parent gate for every passkey suite. ENABLED BY DEFAULT — set to false to skip
# them all. On its own it runs nothing: each cycle below is still opt-in.
ENABLE_PASSKEY_TESTS=
ENABLE_PASSKEY_INIT_DEPOSIT_TESTS=
ENABLE_PASSKEY_INIT_WITHDRAW_TESTS=
ENABLE_PASSKEY_INIT_TRANSFER_TESTS=
ENABLE_PASSKEY_INIT_VAULT_UPGRADE_TESTS=
# Cancel a queued withdrawal: the payload request needs
# TEST_CANCEL_WITHDRAWAL_TRANSACTION_ID (see below) for its happy path
ENABLE_PASSKEY_INIT_CANCEL_WITHDRAW_TESTS=
ENABLE_PASSKEY_DEPOSIT_TX_TESTS=
ENABLE_PASSKEY_WITHDRAW_TX_TESTS=
ENABLE_PASSKEY_VAULT_UPGRADE_TX_TESTS=
# Submits the signed cancellation — needs a cancelWithdrawal entry in
# fixtures/test-data/__generated__/generated-tx-passkey.json
ENABLE_PASSKEY_CANCEL_WITHDRAW_TX_TESTS=

ENABLE_OTP_TESTS=
ENABLE_OTP_INIT_APPROVE_TESTS=
ENABLE_OTP_INIT_DEPOSIT_TESTS=
ENABLE_OTP_INIT_WITHDRAW_TESTS=
ENABLE_OTP_APPROVE_TX_TESTS=
ENABLE_OTP_DEPOSIT_TX_TESTS=
ENABLE_OTP_WITHDRAW_TX_TESTS=

ENABLE_SIGN_ACTIVATE_ACCOUNT=

# Individual test accounts 
TEST_PASSKEY_TARGET_ACCOUNT_ID=
TEST_INIT_ACTIVATE_TARGET_ACCOUNT_ID=
TEST_INIT_DEPOSIT_TARGET_ACCOUNT_ID=
TEST_INIT_WITHDRAW_TARGET_ACCOUNT_ID=
TEST_INIT_TRANSFER_TARGET_ACCOUNT_ID=
TEST_EUR_BANK_ACCOUNT_ID=

# To run only user creation tests, use `CREATE_ENTITY=false`
CREATE_USER=
CREATE_ENTITY=

# Associated persons tests (tests/*/associated-persons.test.js). Both steps are
# OPT-IN — they are gated directly on these variables, not on a FEATURE_FLAGS
# entry, so leaving them blank means the suite never runs.
#   Step 1, POST /v1/submit/add-associated-person
ADD_ASSOCIATED_PERSONS=
#   Step 2, PATCH /v1/submit/update-associated-person
UPDATE_BENEFICIARY=
# Send the exact emails from the add-associated-persons.json fixture instead of
# generating a unique address per person. Default: false (generate unique).
USE_FIXTURE_EMAIL=

# Entity update (tests/*/entity-update-flow.test.js). OPT-IN and gated directly
# on this variable: PATCH /v1/submit/update-entity-account with the body in
# fixtures/test-data/entities/update-entity.json.
UPDATE_ENTITY=

# Append a timestamp suffix to test emails to avoid "already exists" conflicts
# on repeated runs. Leave blank/false to use fixture emails as-is (e.g. to
# receive OTP at a known inbox). Default: false.
UNIQUE_EMAILS=

# User invitation tests (enabled by default)
INVITE_PAYLOAD=
INVITE_USERS=

# Role management tests (disabled by default, requires passkey authentication)
UPDATE_ROLE_PAYLOAD=
UPDATE_ROLE=

# Invitation query tests (enabled by default): get-invitations-by-account-id,
# get-invitations-by-email and the integrator-wide get-all-invitations listing.
# Reads only, so independent of ENABLE_WRITE_TESTS.
ENABLE_INVITATION_QUERIES=

# Event history tests, GET /v1/query/events (read-only, enabled by default)
ENABLE_EVENTS_TESTS=

# Integrator key management tests, /v1/integrator/* (read-only whoami and
# credential listing, enabled by default)
ENABLE_INTEGRATOR_TESTS=
# Opt-in: the credential lifecycle issues REAL credentials on the integrator
# account (create → update → revoke) and deletes them again. Requires
# ENABLE_WRITE_TESTS=true and never runs against production.
ENABLE_INTEGRATOR_CREDENTIAL_TESTS=

# Webhook tests (read-only queries enabled by default; the create/update/delete/test/retry
# lifecycle additionally requires ENABLE_WRITE_TESTS=true)
ENABLE_WEBHOOK_TESTS=
# Optional: URL the test subscription points at. Defaults to https://example.com/byzantine-webhook
TEST_WEBHOOK_URL=
# Optional: an existing subscription ID to use for read/test/retry checks instead of creating one
TEST_WEBHOOK_SUBSCRIPTION_ID=

# --- Local lifecycle-event testing (scripts/simulate-sumsub-review.js) ---
# Must match the local API's Sumsub webhook secret — used to sign the simulated
# inbound Sumsub webhook (HMAC-SHA256 in the x-payload-digest header).
SUMSUB_WEBHOOK_SECRET=
# The created user's UUID (externalUserId) to drive a review for. Can also be
# passed as the first CLI arg to the script.
SUMSUB_EXTERNAL_USER_ID=
# Optional payload overrides
SUMSUB_APPLICANT_ID=
SUMSUB_LEVEL_NAME=
SUMSUB_REVIEW_ANSWER=

# --- Opt-in E2E lifecycle-event delivery test (webhook-lifecycle-events.test.js) ---
# Drives a real customer.* event through the inbound Sumsub webhook and asserts it
# gets delivered to a subscription. Requires all of the following plus the
# SUMSUB_* values above (SUMSUB_WEBHOOK_SECRET must match the TARGET API's secret,
# SUMSUB_EXTERNAL_USER_ID must be a GREEN sandbox applicant for customer.active).
ENABLE_WEBHOOK_LIFECYCLE_TESTS=
# Subscription to observe. Reuses TEST_WEBHOOK_SUBSCRIPTION_ID if set; otherwise
# the test picks the only existing subscription (errors if 0 or >1).
# The event type expected to land (default: customer.active).
WEBHOOK_LIFECYCLE_EXPECTED_EVENT=
# How long to poll deliveries for the event, in ms (default: 30000).
WEBHOOK_LIFECYCLE_TIMEOUT_MS=

# --- Opt-in fan-out concurrency test (webhook-concurrency.test.js) ---
# Creates N subscriptions → one receiver, triggers one customer.created, and
# asserts the single event fans out to N deliveries that all succeed. Observe
# the worker's in-flight cap (4) at the receiver: run
# scripts/webhook/webhook-receiver-slow.js behind ngrok, then this test (or
# scripts/webhook/webhook-fanout-test.js). Requires ENABLE_WRITE_TESTS=true, a reachable
# TEST_WEBHOOK_URL, and never runs against production.
ENABLE_WEBHOOK_CONCURRENCY_TESTS=
# Number of subscriptions / simultaneous deliveries to generate (default: 12).
FANOUT_COUNT=
# How long to poll deliveries for all N to drain, in ms (default: 40000).
WEBHOOK_CONCURRENCY_TIMEOUT_MS=

# ============================================
# Debugging
# ============================================
DEBUG_MODE=


# ============================================
# DEPOSIT AND WITHDRAW AMOUNTS AND CURRENCIES
# ============================================

# For individual tests and CI tests
DEPOSIT_AMOUNT=
SOURCE_CURRENCY=
WITHDRAW_AMOUNT=
DESTINATION_CURRENCY=

# Wallet-to-wallet transfer (get-transfer-payload-passkey).
# TRANSFER_CURRENCY is a CryptoCurrency: usdc | eurc
TRANSFER_AMOUNT=
TRANSFER_CURRENCY=
TRANSFER_DESTINATION_ADDRESS=

# ============================================
# Test data used in production testing mode (related to Bridge)
# ============================================
TEST_VAULT_ETH=
TEST_VAULT_BASE=

TEST_USER_ID=
TEST_ACCOUNT_ID=
TEST_ENTITY_ID=
TEST_ENTITY_ACCOUNT_ID=
TEST_TRANSACTION_ID=

# Withdrawal to cancel, for get-cancel-withdrawal-payload-passkey. Must be a
# withdrawal still queued (status `withdrawal_initiated`) — a settled one answers
# 400. Vault type is not the gate: queued withdrawals occur on vaults reported as
# `is_async_vault: false` too. Set it per run (the transactionId the withdraw
# payload returned); without it the cancel happy-path test skips.
TEST_CANCEL_WITHDRAWAL_TRANSACTION_ID=

# Additional user ID for role management tests
TEST_ADDITIONAL_USER_ID=

DEBUG_URL=

TEST_USER_EMAIL=


ENABLE_OTP_INIT_AUTH_TESTS=
ENABLE_OTP_AUTHENTICATE_TESTS=
ENABLE_OTP_CREATE_AUTHENTICATORS_TESTS=
TEST_OTP_CODE=

# ============================================
# CI TESTS
# ============================================

# account management tests (this is a KYC/KYB-approved account on sumsub and on bridge for bank account operations)
TEST_BANK_ACCOUNT_TARGET_ID=

# account id for get-transactions endpoint (needs an account that has a bridgeCustomerId)
GET_TRANSACTIONS_ACCOUNT_ID=

# Create individual account with ci-one-time-setup.js output (run once, used for virtual auth)
# Account with approved KYC on sumsub only, no approved kyc on Bridge
CI_PASSKEY_CREDENTIAL_ID=
CI_PASSKEY_PRIVATE_KEY=
CI_PASSKEY_ACCOUNT_ID=
CI_PASSKEY_USER_ID=
CI_PASSKEY_EMAIL=
CI_PASSKEY_WALLET_ADDRESS=

# Create entity account with ci-one-time-setup.js output (run once, used for virtual auth)
# Account with approved KYC on sumsub only, no approved kyc on Bridge
CI_ENTITY_PASSKEY_CREDENTIAL_ID=
CI_ENTITY_PASSKEY_PRIVATE_KEY=
CI_ENTITY_PASSKEY_ACCOUNT_ID=
CI_ENTITY_PASSKEY_ENTITY_ID=
CI_ENTITY_PASSKEY_ROOT_USER_ID=
CI_ENTITY_PASSKEY_EMAIL=

# CI_TEST_ORCHESTRATED is NOT set here — ci-test.js sets it on itself and passes
# it to the child vitest processes. Tests read it to switch to the CI passkey
# accounts (CI_PASSKEY_* / CI_ENTITY_PASSKEY_*) instead of the locally generated
# ones. Setting it by hand makes a plain `npx vitest` run target the CI accounts,
# which is normally not what you want.

# CI flags
ENABLE_PASSKEY_ACTIVATE_TX_TESTS=
ENABLE_PASSKEY_ACTIVATE_ETH_TX_TESTS=
ENABLE_PASSKEY_DEPOSIT_TX_TESTS=
ENABLE_PASSKEY_WITHDRAW_TX_TESTS=

# Enable the full invite → OTP → authenticator flow in ci-test.js
ENABLE_INVITE_OTP_FLOW=

# Mailslurp API key for automatic OTP retrieval via disposable email inboxes
MAILSLURP_API_KEY=

# ============================================
# VALIDATION TESTS
# ============================================

# Testing beneficiary ID
TEST_BENEFICIARY_ID=

# Testing vault upgrade from Base to Ethereum
# Account approved on Sumsub and on Bridge + activated on both chains + Passkey available in Chrome
TEST_INIT_VAULT_UPGRADE_TARGET_ACCOUNT_ID=
TEST_VAULT_UPGRADE_SOURCE_ADDR=
UPGRADE_VAULT_DEPOSIT_AMOUNT=
UPGRADE_VAULT_SOURCE_CURRENCY=
REAL_BANK_ACCOUNT_ID=
DESTINATION_VAULT_ADDR=
UPGRADE_VAULT_DESTINATION_CURRENCY=

# Testing faster transaction validation
ENABLE_FASTER_TRANSACTION_VALIDATION_TESTS=
TEST_FASTER_TX_ACCOUNT_ID=                                                                  
TEST_FASTER_TX_VAULT_ADDR=
TEST_FASTER_TX_DEPOSIT_AMOUNT=                                                               
TEST_FASTER_TX_WITHDRAW_AMOUNT=                                
TEST_FASTER_TX_SOURCE_CURRENCY=                                                             
TEST_FASTER_TX_DESTINATION_CURRENCY=

# Testing get-account-details endpoint
ENABLE_GET_ACCOUNT_DETAILS_VALIDATION_TESTS=
TEST_GET_ACCOUNT_DETAILS_IDS=

# Turnkey API (delete-authenticators script)
TURNKEY_API_PRIVATE_KEY=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_BASE_URL=https://api.turnkey.com

# ============================================
# DEBUG TOOL (debug/ — npm run debug)
# ============================================
# Archive-capable RPC endpoints (Alchemy/Infura/...). Required for the
# "state at the failing block" checks: balance, allowance, caps, replay.
# Without them the tool falls back to public endpoints, which usually refuse
# historical state.
RPC_URL_ETH=
RPC_URL_BASE=

# Etherscan V2 API key — ONE key covers Ethereum, Base and the other supported
# chains. Enables verified-ABI decoding (function + custom error names for any
# contract) and full address history for the timeline.
ETHERSCAN_API_KEY=

# Port for the local debug UI (default 4321)
DEBUG_TOOL_PORT=

# Timeline half-width in seconds, i.e. how far before/after the failing block to
# look (default 3600 = ±1 hour)
DEBUG_TIMELINE_WINDOW_SECONDS=

# How many vault names to resolve on-chain when the Byzantine vault list has no
# names (used to detect vaults sharing a display name). Default 60.
DEBUG_VAULT_NAME_LOOKUPS=
