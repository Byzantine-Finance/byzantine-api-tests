# ============================================
# CI/CD Environment Configuration
# ============================================
# Copy these values to your CI secrets or use the GitHub Actions workflow
# which auto-generates .env from repository secrets.
#
# Required secrets in GitHub:
#   - DEV_INTEGRATOR_PRIVATE_KEY
#   - PROD_INTEGRATOR_PRIVATE_KEY (only for production tests)

# ============================================
# Environment
# ============================================
TEST_ENV=development
CHAIN=BASE
CI=true

# ============================================
# Authentication (set via CI secrets)
# ============================================
DEV_INTEGRATOR_PRIVATE_KEY=

# ============================================
# Feature Flags - CI Defaults
# ============================================
# Write tests (account creation, updates, etc.)
ENABLE_WRITE_TESTS=true

# Passkey tests - all enabled for CI
ENABLE_PASSKEY_TESTS=true
ENABLE_PASSKEY_INIT_ACTIVATE_TESTS=true
ENABLE_PASSKEY_INIT_DEPOSIT_TESTS=true
ENABLE_PASSKEY_INIT_WITHDRAW_TESTS=true
ENABLE_PASSKEY_ACTIVATE_TX_TESTS=true
ENABLE_PASSKEY_DEPOSIT_TX_TESTS=true
ENABLE_PASSKEY_WITHDRAW_TX_TESTS=true

# Virtual authenticator - MUST be true for automated passkey stamp generation
USE_VIRTUAL_AUTH=true
VIRTUAL_AUTH_PORT=3000
VIRTUAL_AUTH_RPID=localhost

# OTP tests - ALWAYS disabled in CI (require email-based human intervention)
ENABLE_OTP_TESTS=false
ENABLE_OTP_INIT_DEPOSIT_TESTS=false
ENABLE_OTP_INIT_WITHDRAW_TESTS=false
ENABLE_OTP_DEPOSIT_TX_TESTS=false
ENABLE_OTP_WITHDRAW_TX_TESTS=false
ENABLE_OTP_INIT_AUTH_TESTS=false
ENABLE_OTP_AUTHENTICATE_TESTS=false
ENABLE_OTP_CREATE_AUTHENTICATORS_TESTS=false

# Role management (optional - enable if entity accounts are set up)
UPDATE_ROLE_PAYLOAD=false
UPDATE_ROLE=false

# Account creation (enabled by default)
CREATE_USER=true
CREATE_ENTITY=true

# Invitation queries
ENABLE_INVITATION_QUERIES=true
