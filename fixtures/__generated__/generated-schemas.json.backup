      "rootUsers",
      "byzantineTermsSignedAt"
    ],
    "properties": {
      "entityInfo": {
        "$ref": "#/components/schemas/EntityInfo"
      },
      "entityDocuments": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/components/schemas/EntityVerificationDocument"
        }
      },
      "rootUsers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/EntityRootUserRequest"
        }
      },
      "associatedPersons": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/components/schemas/AssociatedPerson"
        }
      },
      "walletAddress": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional wallet address for self-custodial accounts. If provided, no Turnkey sub-organization will be created and `required_approvals` will be set to 0."
      },
      "byzantineTermsSignedAt": {
        "type": "string",
        "description": "The timestamp when the Byzantine Finance Terms & Conditions were signed. For more information, see [individual account creation - KYC](https://docs.byzantine.fi/api-reference/kyc)."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "CreateEntityAccountResponse": {
    "type": "object",
    "description": "Response body for creating a Byzantine entity",
    "required": [
      "entityId",
      "accountId",
      "verificationStatus",
      "entityInfo",
      "rootUsers",
      "walletAddress",
      "byzantineTermsSignedAt"
    ],
    "properties": {
      "entityId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "accountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "verificationStatus": {
        "$ref": "#/components/schemas/VerificationStatus"
      },
      "entityInfo": {
        "$ref": "#/components/schemas/EntityInfo"
      },
      "entityDocuments": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/components/schemas/VerificationDocumentResponse"
        }
      },
      "rootUsers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/EntityRootUserResponse"
        }
      },
      "associatedPersons": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/components/schemas/AssociatedPersonResponse"
        }
      },
      "walletAddress": {
        "type": "string",
        "description": "The wallet address associated with this account."
      },
      "byzantineTermsSignedAt": {
        "type": "string",
        "description": "The timestamp when the Byzantine Finance Terms & Conditions were signed. For more information, see [individual account creation - KYC](https://docs.byzantine.fi/api-reference/kyc)."
      },
      "missingCompanyData": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "description": "List of missing required company data. Present only if not all required company information has been provided."
      },
      "missingDocuments": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "description": "List of missing required entity verification documents. Present only if not all required documents have been submitted."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "CreateIndividualAccountRequest": {
    "type": "object",
    "description": "User to be created. The vast majority of fields are required in order to complete the identity verification process.",
    "required": [
      "userInfo",
      "byzantineTermsSignedAt",
      "rootUsers"
    ],
    "properties": {
      "userInfo": {
        "$ref": "#/components/schemas/UserInfo"
      },
      "additionalUserInfo": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/AdditionalUserInfo"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "verificationDocuments": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/components/schemas/UserVerificationDocument"
        }
      },
      "byzantineTermsSignedAt": {
        "type": "string",
        "description": "The timestamp when the Byzantine Finance Terms & Conditions were signed. For more information, see [individual account creation - KYC](https://docs.byzantine.fi/api-reference/kyc)."
      },
      "walletAddress": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional wallet address for self-custodial accounts. If provided, no Turnkey sub-organization will be created and `required_approvals` will be set to 0."
      },
      "rootUsers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/IndividualRootUserRequest"
        }
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "CreateIndividualAccountResponse": {
    "type": "object",
    "description": "Response body for creating a Byzantine user",
    "required": [
      "userId",
      "accountId",
      "verificationStatus",
      "userInfo",
      "walletAddress",
      "byzantineTermsSignedAt",
      "rootUsers"
    ],
    "properties": {
