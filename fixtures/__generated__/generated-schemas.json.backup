  "IndividualCustomer": {
    "type": "object",
    "description": "An individual customer",
    "required": [
      "accountId",
      "userId",
      "firstName",
      "lastName",
      "email",
      "verificationStatus",
      "createdAt",
      "updatedAt"
    ],
    "properties": {
      "accountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "userId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "firstName": {
        "type": "string"
      },
      "lastName": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "verificationStatus": {
        "$ref": "#/components/schemas/VerificationStatus"
      },
      "logoUrl": {
        "type": [
          "string",
          "null"
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "IndividualRootUserRequest": {
    "type": "object",
    "description": "The root users (signers) of the account. This can be the owner themselves (same\nemail as `user_info`), or a wealth manager / CGP operating on behalf of the owner.\nAt least one is required at creation.",
    "required": [
      "firstName",
      "lastName",
      "email"
    ],
    "properties": {
      "firstName": {
        "type": "string"
      },
      "lastName": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "authenticators": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/components/schemas/AuthenticatorParam"
        }
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "IndividualRootUserResponse": {
    "type": "object",
    "description": "A root user (signer) created for an individual account.",
    "required": [
      "userId",
      "firstName",
      "lastName",
      "email",
      "isPasskeyActivated",
      "isOtpActivated"
    ],
    "properties": {
      "userId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "firstName": {
        "type": "string"
      },
      "lastName": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "isPasskeyActivated": {
        "type": "boolean",
        "description": "An indicator showing whether passkey authentication is active for this root user. For more information, see [wallet authentication](https://docs.byzantine.fi/api-reference/wallet-authentication)."
      },
      "isOtpActivated": {
        "type": "boolean",
        "description": "An indicator showing whether OTP authentication is active for this root user. For more information, see [wallet authentication](https://docs.byzantine.fi/api-reference/wallet-authentication)."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InitOtpRequest": {
    "type": "object",
    "description": "Request to initialize OTP (email) for a user",
    "required": [
      "accountId",
      "userId"
    ],
    "properties": {
      "accountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "userId": {
        "$ref": "#/components/schemas/Uuid"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InitOtpResponse": {
    "type": "object",
    "description": "Response from initializing OTP",
    "required": [
      "otpId"
    ],
    "properties": {
      "otpId": {
        "type": "string",
        "description": "Unique identifier for the OTP request"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InvitationStatus": {
    "type": "string",
    "description": "Status of an invitation.",
    "enum": [
      "pending",
      "accepted",
      "rejected",
      "cancelled"
    ],
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InvitationWithUserDetails": {
    "type": "object",
    "description": "Invitation with user details (email and name)",
    "required": [
      "invitation_id",
      "account_id",
      "user_id",
      "first_name",
      "last_name",
      "user_email",
      "invited_by",
      "status",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "invitation_id": {
        "$ref": "#/components/schemas/Uuid"
      },
      "account_id": {
        "$ref": "#/components/schemas/Uuid"
      },
      "user_id": {
        "$ref": "#/components/schemas/Uuid"
      },
      "first_name": {
        "type": "string"
      },
      "last_name": {
        "type": "string"
      },
      "user_email": {
        "type": "string"
      },
      "invited_by": {
        "$ref": "#/components/schemas/Uuid"
      },
      "status": {
        "$ref": "#/components/schemas/InvitationStatus"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InviteUsersRequest": {
    "type": "object",
    "description": "Request body for inviting a user to a Byzantine account",
    "required": [
      "accountId",
      "newUsers"
    ],
    "properties": {
      "accountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "newUsers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/NewUser"
        }
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InviteUsersRequestBodyPasskey": {
    "type": "object",
    "required": [
      "signedBody",
      "invitedBy",
      "webAuthnStamp"
    ],
    "properties": {
      "signedBody": {
        "$ref": "#/components/schemas/CreateUsersRequest"
      },
      "invitedBy": {
        "$ref": "#/components/schemas/Uuid"
      },
      "webAuthnStamp": {
        "type": "string",
        "description": "Cryptographically passkey signed (stamped). For more info, see [wallet authentication](https://docs.byzantine.fi/api-reference/wallet-authentication)."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InviteUsersRequestResponse": {
    "type": "object",
    "required": [
      "bodyToSign"
    ],
    "properties": {
      "bodyToSign": {
        "$ref": "#/components/schemas/CreateUsersRequest"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InviteUsersResponse": {
    "type": "object",
    "description": "Response body when new users are successfully invited to a Byzantine account",
    "required": [
      "accountId",
      "newUsers",
      "invitedBy",
      "invitedAt"
    ],
    "properties": {
      "accountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "newUsers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/InvitedUser"
        }
      },
      "invitedBy": {
        "$ref": "#/components/schemas/Uuid"
      },
      "invitedAt": {
        "type": "string",
        "format": "date-time",
        "description": "The timestamp when the users were invited."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "InvitedUser": {
    "type": "object",
    "description": "The details of the new users invited.",
    "required": [
      "userId",
      "firstName",
      "lastName",
      "userEmail"
    ],
    "properties": {
      "userId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "firstName": {
        "type": "string",
        "description": "The first name of the new user."
      },
      "lastName": {
        "type": "string",
        "description": "The last name of the new user."
      },
      "userEmail": {
        "type": "string",
        "description": "The email of the new user."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "IsSmartAccountByChain": {
    "type": "object",
    "required": [
      "ethereum",
      "base"
    ],
    "properties": {
      "ethereum": {
        "type": "boolean",
        "description": "Atlas delegation active on Ethereum Mainnet (chain_id 1)"
      },
      "base": {
        "type": "boolean",
        "description": "Atlas delegation active on Base (chain_id 8453)"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "LiquidationAddress": {
    "type": "object",
    "required": [
      "bankAccountId",
      "accountId",
      "name",
      "liquidationAddress",
      "createdAt",
      "destinationCurrency",
      "destinationRail"
    ],
    "properties": {
      "bankAccountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "accountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "name": {
        "type": "string"
      },
      "liquidationAddress": {
        "type": "string"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "destinationCurrency": {
        "$ref": "#/components/schemas/Currency"
      },
      "destinationRail": {
        "$ref": "#/components/schemas/PaymentRail"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "ListWebhookDeliveriesResponse": {
    "type": "object",
    "required": [
      "deliveries"
    ],
    "properties": {
      "deliveries": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/WebhookDeliveryWithAttempts"
        }
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "ListWebhookSubscriptionsResponse": {
    "type": "object",
    "required": [
      "subscriptions"
    ],
    "properties": {
      "subscriptions": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/WebhookSubscriptionResponse"
        }
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "NaiveDateTime": {
    "type": "string",
    "format": "date-time",
    "description": "A naive datetime string without timezone",
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "NewUser": {
    "type": "object",
    "description": "The details of the new user to invite.",
    "required": [
      "firstName",
      "lastName",
      "userEmail"
    ],
    "properties": {
      "firstName": {
        "type": "string",
        "description": "The first name of the user to invite."
      },
      "lastName": {
        "type": "string",
        "description": "The last name of the user to invite."
      },
      "userEmail": {
        "type": "string",
        "description": "The email of the user to invite."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "OAuthProviderParam": {
    "type": "object",
    "required": [
      "providerName",
      "oidcToken"
    ],
    "properties": {
      "providerName": {
        "type": "string"
      },
      "oidcToken": {
        "type": "string"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "OtpAuthRequestBody": {
    "type": "object",
    "description": "Request to authenticate with OTP code",
    "required": [
      "accountId",
      "userId",
      "otpId",
      "otpCode"
    ],
    "properties": {
      "accountId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "userId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "otpId": {
        "type": "string",
        "description": "The OTP ID returned by init-otp"
      },
      "otpCode": {
        "type": "string",
        "description": "The OTP code received by email"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "OtpAuthResponse": {
    "type": "object",
    "description": "Response from OTP authentication",
    "required": [
      "session",
      "sessionId",
      "expiresAt"
    ],
    "properties": {
      "session": {
        "type": "string",
        "description": "Session metadata"
      },
      "sessionId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "expiresAt": {
        "type": "string",
        "description": "Session expiration timestamp (ISO 8601)"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "PasskeyPayloadRequestResponse": {
    "type": "object",
    "required": [
      "bodyToSign",
      "transactionId"
    ],
    "properties": {
      "bodyToSign": {
        "$ref": "#/components/schemas/SignRawPayloadRequest"
      },
      "transactionId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "destinationBankAccount": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/BankAccount"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "PaymentRail": {
    "type": "string",
    "enum": [
      "ach",
      "sepa",
      "ethereum",
      "base"
    ],
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "PaymentRailVirtualAccount": {
    "type": "string",
    "enum": [
      "achPush",
      "fedNow",
      "pix",
      "sepa",
      "spei",
      "wire",
      "unknown"
    ],
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "PendingInvitation": {
    "type": "object",
    "description": "Response body for a pending invitation",
    "required": [
      "invitationId",
      "userId",
      "role",
      "firstName",
      "lastName",
      "userEmail",
      "invitedBy"
    ],
    "properties": {
      "invitationId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "userId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "role": {
        "$ref": "#/components/schemas/AccountUserRole"
      },
      "firstName": {
        "type": "string"
      },
      "lastName": {
        "type": "string"
      },
      "userEmail": {
        "type": "string"
      },
      "invitedBy": {
        "$ref": "#/components/schemas/Uuid"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SendTransactionResponseBody": {
    "type": "object",
    "required": [
      "transactionId",
      "status"
    ],
    "properties": {
      "transactionId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "status": {
        "$ref": "#/components/schemas/TransactionStatus"
      },
      "broadcastedAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time",
        "description": "Exact timestamp when the transaction was broadcasted on-chain."
      },
      "transactionHash": {
        "type": [
          "string",
          "null"
        ],
        "description": "The on-chain transaction hash. Available immediately after broadcast - poll\nRPC's `eth_getTransactionReceipt` to get the full receipt."
      },
      "fiatDepositInstructions": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/SourceDepositInstructions"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "destinationBankAccount": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/BankAccount"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignPayloadRequestBodyPasskey": {
    "type": "object",
    "required": [
      "signedBody",
      "transactionId",
      "webAuthnStamp"
    ],
    "properties": {
      "signedBody": {
        "$ref": "#/components/schemas/SignedBody"
      },
      "transactionId": {
        "$ref": "#/components/schemas/Uuid"
      },
      "webAuthnStamp": {
        "type": "string",
        "description": "Cryptographically passkey signed (stamped). For more info, see [wallet authentication](https://docs.byzantine.fi/api-reference/wallet-authentication)."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignRawPayloadParams": {
    "type": "object",
    "description": "The parameters object containing the specific intent data for this transaction.",
    "required": [
      "signWith",
      "payload",
      "encoding",
      "hashFunction"
    ],
    "properties": {
      "signWith": {
        "type": "string",
        "description": "A Wallet account address, Private Key address, or Private Key identifier."
      },
      "payload": {
        "type": "string",
        "description": "Raw unsigned payload to be signed."
      },
      "encoding": {
        "type": "string",
        "description": "How the payload is encoded: `PAYLOAD_ENCODING_HEXADECIMAL` or `PAYLOAD_ENCODING_EIP7702_AUTHORIZATION`"
      },
      "hashFunction": {
        "type": "string",
        "description": "Rather Turnkey should hash the message or not: `HASH_FUNCTION_NO_OP` or `HASH_FUNCTION_KECCAK256`"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignRawPayloadRequest": {
    "type": "object",
    "description": "The object that needs to be signed by the end user to make a transaction.",
    "required": [
      "type",
      "timestampMs",
      "organizationId",
      "parameters"
    ],
    "properties": {
      "type": {
        "type": "string",
        "description": "Defaults to `ACTIVITY_TYPE_SIGN_RAW_PAYLOAD_V2`"
      },
      "timestampMs": {
        "type": "string",
        "description": "UNIX timestamp of the creation of the transaction."
      },
      "organizationId": {
        "type": "string",
        "description": "The account ID making the transaction."
      },
      "parameters": {
        "$ref": "#/components/schemas/SignRawPayloadParams"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignRawPayloadsParams": {
    "type": "object",
    "description": "The parameters object containing the specific intent data for this batch of transactions.",
    "required": [
      "signWith",
      "payloads",
      "encoding",
      "hashFunction"
    ],
    "properties": {
      "signWith": {
        "type": "string",
        "description": "A Wallet account address, Private Key address, or Private Key identifier."
      },
      "payloads": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "An array of raw unsigned payloads to be signed."
      },
      "encoding": {
        "type": "string",
        "description": "How the payload is encoded: `PAYLOAD_ENCODING_HEXADECIMAL` or `PAYLOAD_ENCODING_EIP7702_AUTHORIZATION`"
      },
      "hashFunction": {
        "type": "string",
        "description": "Rather Turnkey should hash the message or not: `HASH_FUNCTION_NO_OP` or `HASH_FUNCTION_KECCAK256`"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignRawPayloadsRequest": {
    "type": "object",
    "description": "The object that needs to be signed by the end user to make a batch of transactions.",
    "required": [
      "type",
      "timestampMs",
      "organizationId",
      "parameters"
    ],
    "properties": {
      "type": {
        "type": "string",
        "description": "Defaults to `ACTIVITY_TYPE_SIGN_RAW_PAYLOADS`."
      },
      "timestampMs": {
        "type": "string",
        "description": "UNIX timestamp of the creation of the transaction."
      },
      "organizationId": {
        "type": "string",
        "description": "The account ID making the transaction."
      },
      "parameters": {
        "$ref": "#/components/schemas/SignRawPayloadsParams"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignTransactionParams": {
    "type": "object",
    "description": "The parameters object containing the specific intent data for this transaction.",
    "required": [
      "signWith",
      "unsignedTransaction",
      "type"
    ],
    "properties": {
      "signWith": {
        "type": "string",
        "description": "A Wallet account address, Private Key address, or Private Key identifier."
      },
      "unsignedTransaction": {
        "type": "string",
        "description": "Raw unsigned transaction to be signed."
      },
      "type": {
        "type": "string",
        "description": "Defaults to `TRANSACTION_TYPE_ETHEREUM`"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignTransactionRequest": {
    "type": "object",
    "description": "The object that needs to be signed by the end user to make a transaction.",
    "required": [
      "type",
      "timestampMs",
      "organizationId",
      "parameters"
    ],
    "properties": {
      "type": {
        "type": "string",
        "description": "Defaults to `ACTIVITY_TYPE_SIGN_TRANSACTION_V2`"
      },
      "timestampMs": {
        "type": "string",
        "description": "UNIX timestamp of the creation of the transaction."
      },
      "organizationId": {
        "type": "string",
        "description": "The account ID making the transaction."
      },
      "parameters": {
        "$ref": "#/components/schemas/SignTransactionParams"
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SignedBody": {
    "oneOf": [
      {
        "$ref": "#/components/schemas/SignRawPayloadRequest"
      },
      {
        "$ref": "#/components/schemas/SignRawPayloadsRequest"
      }
    ],
    "description": "Accepts either a single-payload or a multi-payload request Turnkey request",
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SortOrder": {
    "type": "string",
    "description": "Chronological sort direction over the field `updatedAt`.",
    "enum": [
      "asc",
      "desc"
    ],
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
  "SourceDepositInstructions": {
    "type": "object",
    "required": [
      "currency",
      "bankName",
      "bankAddress",
      "paymentRails",
      "bankBeneficiaryName"
    ],
    "properties": {
      "currency": {
        "$ref": "#/components/schemas/Currency"
      },
      "expectedDepositAmount": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/Decimal"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "bankName": {
        "type": "string",
        "description": "The name of the beneficiary bank."
      },
      "bankAddress": {
        "type": "string",
        "description": "The address of the beneficiary bank."
      },
      "paymentRails": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/PaymentRailVirtualAccount"
        }
      },
      "bankBeneficiaryName": {
        "type": "string",
        "description": "The name of the beneficiary. Either first and last name, or a business name."
      },
      "bankBeneficiaryAddress": {
        "type": [
          "string",
          "null"
        ],
        "description": "The address of the beneficiary. Not returned by Bridge for all rails (e.g. omitted on SEPA virtual accounts)."
      },
      "bankAccountNumber": {
        "type": [
          "string",
          "null"
        ],
        "description": "In case of a USD deposit, the bank account number to deposit to."
      },
      "bankRoutingNumber": {
        "type": [
          "string",
          "null"
        ],
        "description": "In case of a USD deposit, the ban routing number to deposit to."
      },
      "iban": {
        "type": [
          "string",
          "null"
        ],
        "description": "In case of a EUR deposit, the IBAN to deposit to."
      },
      "bic": {
        "type": [
          "string",
          "null"
        ],
        "description": "In case of a EUR deposit, the BIC to deposit to."
      }
    },
    "$schema": "http://json-schema.org/draft-04/schema#"
  },
