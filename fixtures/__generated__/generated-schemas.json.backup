        "maximum": 9223372036854776000
      },
      "limit": {
        "type": "integer",
        "format": "int64",
        "description": "Page size (max 100). Defaults to 20.",
        "minimum": -9223372036854776000,
        "maximum": 9223372036854776000
      },
      "offset": {
        "type": "integer",
        "format": "int64",
