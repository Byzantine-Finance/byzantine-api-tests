              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "sourceAmount": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/Decimal"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
